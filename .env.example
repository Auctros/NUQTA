# ---------------------------------------------------------------------------
# NUQTA sync — example configuration
#
# Copy to `.env` for local use. `.env` is git-ignored; this file is not secret.
#
# There are TWO separate groups:
#   * build-time (VITE_*) — compiled into the browser bundle, so they are PUBLIC.
#     Never put a credential here; anyone who loads the app can read it.
#   * server-side (NUQTA_SYNC_*) — read by `scripts/serve-dist.mjs` at runtime.
#
# Leave VITE_NUQTA_SYNC_URL unset to keep the app purely local-first: sync then
# never starts, no socket is opened, and the status badge renders nothing.
# ---------------------------------------------------------------------------

# --- Build time (PUBLIC, compiled into the bundle) -------------------------
# Where the sync endpoint lives. Write the origin you browse through Tailscale
# Serve; it is normalised for you:
#   https://nuqta.<tailnet>.ts.net   -> wss://nuqta.<tailnet>.ts.net/sync
#   http://127.0.0.1:3000            -> ws://127.0.0.1:3000/sync
# An explicit ws:// / wss:// URL is accepted as-is; `/sync` is appended once.
# Must be the SAME ORIGIN that serves the app: the page ships
# `connect-src 'self'`, so a different host/port is blocked by CSP and sync will
# never connect. Both examples above are same-origin.
# Empty / unset = sync disabled (the default and the safe choice).
VITE_NUQTA_SYNC_URL=

# --- Server side (private, never bundled) ----------------------------------
# Port the local server listens on. Bound to 127.0.0.1 only; Serve proxies to it.
PORT=3000

# Comma-separated Tailscale logins allowed to sync, e.g. you@example.com
# Authentication FAILS CLOSED: with this empty, every /sync request returns 503.
# This is the only identity source. The header is trusted because `tailscale
# serve` sets it; do not expose the server port directly to a network.
NUQTA_SYNC_ALLOWED_USERS=

# Comma-separated browser Origins allowed to call the sync endpoints.
# In production this is your Serve origin, e.g. https://nuqta.<tailnet>.ts.net
NUQTA_SYNC_ALLOWED_ORIGINS=

# Optional convenience: adds the origin derived from this URL to the allow-list.
# NUQTA_TAILSCALE_ORIGIN=

# Where the SQLite change log lives. Relative paths resolve under the repo root.
# Default when unset: ./data/sync-server.sqlite
NUQTA_SYNC_DB_PATH=./data/sync-server.sqlite

# --- Local development only ------------------------------------------------
# A shared token is still honoured by the server for local testing, but the
# browser client no longer sends one. Do NOT rely on it for real security: a
# token in a frontend bundle is readable by every user.
# NUQTA_SYNC_TOKEN=
# NUQTA_SYNC_REQUIRE_TOKEN_WITH_TAILSCALE=false
